---
/**
 * The one layout. Every page renders through it.
 *
 * Structured data works in two layers: a global LocalBusiness block built from
 * src/data/site.ts, plus whatever a page passes in `jsonLd` (Service, FAQPage,
 * BreadcrumbList…). They are merged into a single @graph so pages never have
 * to restate the business.
 *
 * The old site's JSON-LD had JavaScript `//` comments inside the JSON, which
 * made the whole block unparseable — so none of it ever counted. Everything
 * here goes through JSON.stringify, which cannot produce that bug.
 */
import { site, sameAs } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	/** Path to an OG image in /public. Defaults to the shared social card. */
	ogImage?: string;
	/** Set false on thin or duplicate pages (e.g. /success). */
	index?: boolean;
	/** Extra schema objects merged into the @graph. */
	jsonLd?: Record<string, unknown>[];
	/** Suppress the header's bottom hairline when a hero supplies its own edge. */
	transparentHeader?: boolean;
}

const {
	title,
	description,
	ogImage = '/og-default.jpg',
	index = true,
	jsonLd = [],
	transparentHeader = false,
} = Astro.props;

const siteUrl = site.url;
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteUrl).href.replace(/(.+)\/$/, '$1');
const ogImageUrl = new URL(ogImage, Astro.site ?? siteUrl).href;

const localBusiness = {
	'@type': ['LocalBusiness', 'ProfessionalService'],
	'@id': `${siteUrl}/#business`,
	name: site.legalName,
	alternateName: site.shortName,
	description: site.description,
	url: siteUrl,
	telephone: site.phoneE164,
	...(site.email ? { email: site.email } : {}),
	image: `${siteUrl}/icon-512.png`,
	logo: `${siteUrl}/icon-512.png`,
	priceRange: '$$$$',
	founder: {
		'@type': 'Person',
		name: 'James Lowe',
		jobTitle: 'USCG 200-Ton Licensed Master',
		hasCredential: 'USCG Master 200 GRT Near Coastal Auxiliary Sail',
	},
	address: {
		'@type': 'PostalAddress',
		addressLocality: site.address.locality,
		addressRegion: site.address.region,
		postalCode: site.address.postalCode,
		addressCountry: site.address.country,
	},
	openingHoursSpecification: {
		'@type': 'OpeningHoursSpecification',
		dayOfWeek: [
			'Monday',
			'Tuesday',
			'Wednesday',
			'Thursday',
			'Friday',
			'Saturday',
			'Sunday',
		],
		opens: site.hours.opens,
		closes: site.hours.closes,
	},
	sameAs,
	/**
	 * Deliberately no aggregateRating. The old site carried a 5.0/12 rating
	 * that appeared nowhere on the page — review markup without visible
	 * reviews is a Google structured-data violation, and there are no
	 * published reviews to back it. Add it once real testimonials ship.
	 */
	areaServed: [
		{ '@type': 'Country', name: 'United States' },
		{ '@type': 'Country', name: 'Bahamas' },
		{ '@type': 'Country', name: 'Canada' },
		{ '@type': 'Place', name: 'Caribbean' },
	],
};

const website = {
	'@type': 'WebSite',
	'@id': `${siteUrl}/#website`,
	url: siteUrl,
	name: site.legalName,
	publisher: { '@id': `${siteUrl}/#business` },
};

const graph = {
	'@context': 'https://schema.org',
	'@graph': [localBusiness, website, ...jsonLd],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content={index ? 'index, follow' : 'noindex, follow'} />
		<meta name="author" content="James Lowe" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#1b1a18" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${site.name} — ${site.license}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		{/*
		  Fonts are self-hosted (see the @font-face block in global.css) and
		  preloaded here so they are in flight with the stylesheet rather than
		  after it. Both faces are used above the fold on every page — the
		  headings in Cormorant, the body in Lora — so both are worth preloading;
		  a preload the page does not use is a wasted request, and these are not.
		*/}
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/cormorant-garamond-latin.woff2"
			crossorigin
		/>
		<link rel="preload" as="font" type="font/woff2" href="/fonts/lora-latin.woff2" crossorigin />

		<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

		{/*
		  Opt in to motion. This runs in <head>, before the body paints, so
		  elements that will animate in are never briefly visible first.

		  Everything in the motion layer of global.css hangs off this attribute.
		  If this script does not run — JS disabled, CSP, an error above it — or
		  if the reader prefers reduced motion, the attribute is absent and not
		  one element is ever hidden. Fail open, always.
		*/}
		<script is:inline>
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.dataset.anim = 'on';
			}
		</script>

		{
			site.gaMeasurementId && (
				<>
					<script
						async
						src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`}
						is:inline
					/>
					<script is:inline define:vars={{ id: site.gaMeasurementId }}>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag('js', new Date());
						gtag('config', id);
					</script>
				</>
			)
		}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header transparent={transparentHeader} />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<script is:inline>
			(() => {
				if (document.documentElement.dataset.anim !== 'on') return;

				/* Must match the selector list in the motion layer of global.css. */
				const TARGETS = [
					'.section-head', '.plate-figure', '.grid > *', '.stat', '.step',
					'.rate-card', '.option', '.detail-item', '.fee', '.inc-item',
					'.entry', '.area', '.term', '.cert', '.faq', '.example-row',
					'.flagship', '.aside', '.warning', '.facts', '.creds', '.pull',
					'.next li', '.sec',
				].join(',');

				const els = document.querySelectorAll(TARGETS);
				const revealAll = () => els.forEach((el) => el.setAttribute('data-revealed', ''));

				// Without IntersectionObserver the content would stay hidden forever.
				if (!('IntersectionObserver' in window)) return revealAll();

				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.setAttribute('data-revealed', '');
							io.unobserve(entry.target); // reveal once; never re-hide on scroll up
						}
					},
					// Fire a little before the element reaches the fold, so it has
					// finished arriving by the time it is properly in view.
					{ rootMargin: '0px 0px -10% 0px', threshold: 0.01 },
				);

				els.forEach((el) => io.observe(el));

				/* Belt and braces: if anything is still hidden well after load —
				   an observer that never fired, a zero-height container — show it.
				   Hidden content is a bug; a missed animation is not. */
				window.addEventListener('load', () => {
					setTimeout(() => {
						els.forEach((el) => {
							if (el.hasAttribute('data-revealed')) return;
							const r = el.getBoundingClientRect();
							if (r.top < window.innerHeight && r.bottom > 0) {
								el.setAttribute('data-revealed', '');
							}
						});
					}, 1200);
				});

				/* Counting figures. Only plain integers are touched, and the final
				   text is restored verbatim rather than reformatted. The figures
				   are already set in tabular numerals, so the width never jitters
				   as the digits change. */
				const counters = [...document.querySelectorAll('.stat-value')].filter((el) =>
					/^\d{1,4}$/.test(el.textContent.trim()),
				);

				if (counters.length) {
					const countIO = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								const el = entry.target;
								countIO.unobserve(el);

								const final = el.textContent.trim();
								const target = Number(final);
								// Small numbers have nothing to count through.
								if (target < 5) continue;

								const DURATION = 1100;
								let started = null;

								const tick = (now) => {
									started ??= now;
									const p = Math.min((now - started) / DURATION, 1);
									// Ease out — decelerates into the real figure.
									const eased = 1 - Math.pow(1 - p, 3);
									el.textContent = p < 1 ? String(Math.round(target * eased)) : final;
									if (p < 1) requestAnimationFrame(tick);
								};
								requestAnimationFrame(tick);
							}
						},
						{ threshold: 0.6 },
					);
					counters.forEach((el) => countIO.observe(el));
				}
			})();
		</script>
	</body>
</html>
