---
/**
 * Rates and fees — commercially the most important page on the site.
 *
 * Every figure is computed from RATES in src/data/rates.ts, including the
 * worked example and the speed table. The old page hardcoded a worked example
 * that had fallen ~20% behind the rates printed directly above it; deriving
 * them makes that class of drift impossible.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import FaqList from '../components/FaqList.astro';
import {
	rateCards,
	crewRequirements,
	passThroughFees,
	workedExample,
	speedTable,
	paymentMethods,
	paymentTerms,
} from '../data/rates';
import { faqsByTopic, faqSchema } from '../data/faqs';
import { inline } from '../lib/inline';
import imgPassagePlanning from '../assets/cjl/stock/passage-planning-chart.jpg';

const moneyFaqs = faqsByTopic('money');

const title = 'Rates and Fees | Captain and Crew Daily Rates for Yacht Delivery';
const description =
	'Current daily rates for captain, deckhand and provisions, what is billed at cost, a fully worked cost example, and how boat speed changes the total.';
---

<Layout {title} {description} jsonLd={[faqSchema(moneyFaqs)]}>
	<PageHero
		kicker="Rates and fees"
		heading="You are hiring a crew at a daily rate."
		lede="We are licensed U.S. Coast Guard professional mariners. Our rates reflect industry standards — we plan meticulously, and we are not the cheapest option on the dock."
	/>

	<section class="section">
		<div class="container">
			<div class="rate-cards">
				{
					rateCards.map((r) => (
						<article class="rate-card">
							<h2 class="rate-role">{r.role}</h2>
							<p class="rate-value">${r.amount}</p>
							<p class="rate-unit">{r.unit}</p>
							<p class="rate-note">{r.note}</p>
						</article>
					))
				}
			</div>
			<p class="rate-foot">
				Rates are quoted at the discounted cash price. Everything below the crew line is passed
				through at cost, with nothing added.
			</p>
		</div>
	</section>

	<section class="section band-surface">
		<div class="container split split-top">
			<div>
				<p class="kicker">Crew required</p>
				<h2 class="display-3 no-optical">The boat decides the crew, not the budget.</h2>
				<p class="lede">
					Crew size is a safety decision. It scales with the vessel and with how the passage
					has to be run — a boat kept moving around the clock needs people to relieve each
					other.
				</p>
			</div>
			<div class="table-scroll">
				<table class="table">
					<thead>
						<tr>
							<th scope="col">Vessel</th>
							<th scope="col">Minimum crew</th>
						</tr>
					</thead>
					<tbody>
						{
							crewRequirements.map((c) => (
								<tr>
									<td>{c.vessel}</td>
									<td>{c.crew}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<header class="section-head">
				<p class="kicker">Billed at cost</p>
				<h2 class="display-3">What sits on top of the daily rate.</h2>
				<p class="lede">
					None of these carry a markup. They are the real costs of getting a crew to your boat,
					keeping her running, and getting the crew home again.
				</p>
			</header>
			<div class="grid grid-3 fees">
				{
					passThroughFees.map((f) => (
						<article class="fee">
							<h3 class="fee-title">{f.title}</h3>
							<p class="fee-body">{f.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ── the worked example ── -->
	<section class="section band-ink">
		<div class="container">
			<header class="section-head">
				<p class="kicker">Worked example</p>
				<h2 class="display-3">{workedExample.route}</h2>
				<p class="lede">
					Roughly {workedExample.distanceNm} nautical miles at {workedExample.speedKn} knots — about
					{' '}{workedExample.sailingHours} hours under way. At {workedExample.hoursPerDay}-hour
					summer days, call it {workedExample.daysAboard} days. An illustration, not a quote.
				</p>
			</header>

			<div class="example">
				<dl class="example-lines">
					{
						workedExample.lines.map((l) => (
							<div class="example-row">
								<dt>
									<span class="example-label">{l.label}</span>
									<span class="example-detail">{l.detail}</span>
								</dt>
								<dd class="tnum">{l.value}</dd>
							</div>
						))
					}
					<div class="example-row example-total">
						<dt><span class="example-label">Estimated total</span></dt>
						<dd class="tnum">{workedExample.total}</dd>
					</div>
				</dl>

				<aside class="deposit">
					<h3 class="deposit-head">How it is paid</h3>
					<p class="deposit-line">
						<span>Deposit — about one third</span><span class="tnum">{workedExample.deposit}</span>
					</p>
					<p class="deposit-line">
						<span>Balance on completion</span><span class="tnum">{workedExample.balance}</span>
					</p>
					<p class="deposit-note">
						The deposit reserves the calendar and commissions the crew, and is due no later
						than four days before departure.
					</p>
				</aside>
			</div>
		</div>
	</section>

	<!-- ── the speed table ── -->
	<section class="section">
		<div class="container">
			<header class="section-head">
				<p class="kicker">Why speed matters</p>
				<h2 class="display-3">One knot is worth thousands of dollars.</h2>
				<p class="lede">
					The same {workedExample.distanceNm}-mile passage, costed at different cruising speeds.
					The speed we calculate from is the speed you give us.
				</p>
			</header>

			<div class="table-scroll speed-wrap">
				<table class="table speed">
					<thead>
						<tr>
							<th scope="col">Cruising speed</th>
							<th scope="col">Days under way</th>
							<th scope="col">Estimated total</th>
						</tr>
					</thead>
					<tbody>
						{
							speedTable.map((s) => (
								<tr class:list={{ 'is-example': s.isExample }}>
									<td class="tnum">{s.speed}</td>
									<td class="tnum">{s.days}</td>
									<td class="tnum">{s.total}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>

			<p class="speed-note" set:html={inline(
				'Overstate your boat’s speed and the estimate misses by days, and you pay for those days at the agreed daily rate. **Please don’t exaggerate.** If you are not certain what she actually makes, say so on the form and we will work from a conservative figure.',
			)} />
		</div>
	</section>

	<section class="section band-surface">
		<div class="container split split-top">
			<div>
				<p class="kicker">Payment</p>
				<h2 class="display-3 no-optical">Deposit, balance, cancellation.</h2>
				<ul class="methods">
					{paymentMethods.map((m) => <li class="tag tag-outline">{m}</li>)}
				</ul>
				<p class="methods-note">
					Wire transfer and Zelle are preferred for the deposit. Checks must clear before
					departure and are not accepted for final payment unless agreed in advance.
				</p>
			</div>
			<div class="terms">
				{
					paymentTerms.map((t) => (
						<article class="term">
							<h3 class="term-title">{t.title}</h3>
							<p class="term-body">{t.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<header class="section-head">
				<p class="kicker">Costs and customs</p>
				<h2 class="display-3">Money questions.</h2>
			</header>
			<FaqList items={moneyFaqs} />
		</div>
	</section>

	<FinalCta
		kicker="Start here"
		heading="Want this run for your boat and route?"
		body="Send the vessel details and the passage, and the estimate comes back with your numbers in place of the example’s."
		image={imgPassagePlanning}
		imageAlt="A chart on a wooden table with dividers, a magnifier, a pencil and a mug of coffee"
	/>
</Layout>

<style>
	.section-head {
		max-width: 62ch;
		margin-bottom: clamp(30px, 4vw, 52px);
	}

	/* — rate cards — */
	.rate-cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(20px, 3vw, 36px);
	}
	.rate-card {
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		padding: clamp(22px, 2.8vw, 34px);
	}
	.rate-role {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 var(--space-4);
	}
	.rate-value {
		font-family: var(--font-heading);
		font-weight: 400;
		font-size: clamp(42px, 5vw, 64px);
		line-height: 1;
		margin: 0 0 var(--space-2);
		font-variant-numeric: tabular-nums;
	}
	.rate-unit {
		margin: 0 0 var(--space-3);
		font-size: 13px;
		color: color-mix(in srgb, var(--color-text) 66%, transparent);
	}
	.rate-note {
		margin: 0;
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-divider);
		font-size: 12.5px;
		line-height: 1.55;
		color: color-mix(in srgb, var(--color-text) 72%, transparent);
	}
	.rate-foot {
		margin: clamp(22px, 3vw, 32px) 0 0;
		font-size: 13.5px;
		max-width: 62ch;
		color: color-mix(in srgb, var(--color-text) 70%, transparent);
	}
	@media (max-width: 760px) {
		.rate-cards {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* — pass-through fees — */
	.fee {
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-divider);
	}
	.fee-title {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: clamp(17px, 1.6vw, 20px);
		line-height: 1.25;
		margin: 0 0 var(--space-2);
	}
	.fee-body {
		margin: 0;
		font-size: 13.5px;
		line-height: 1.68;
		color: color-mix(in srgb, var(--color-text) 78%, transparent);
	}

	/* — worked example — */
	.example {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: clamp(28px, 5vw, 72px);
		align-items: start;
	}
	@media (max-width: 900px) {
		.example {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.example-lines {
		margin: 0;
		border-top: 1px solid var(--color-divider);
	}
	.example-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-4);
		border-bottom: 1px solid var(--color-divider);
	}
	.example-row dt {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.example-label {
		font-family: var(--font-heading);
		font-size: clamp(15px, 1.4vw, 17px);
	}
	.example-detail {
		font-size: 12px;
		color: color-mix(in srgb, var(--color-text) 58%, transparent);
	}
	.example-row dd {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(17px, 1.7vw, 21px);
		white-space: nowrap;
	}
	.example-total {
		border-bottom: 0;
	}
	.example-total .example-label {
		color: var(--color-accent);
		letter-spacing: 0.02em;
	}
	.example-total dd {
		font-size: clamp(26px, 3vw, 38px);
		color: var(--color-accent);
	}

	.deposit {
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		padding: clamp(20px, 2.4vw, 28px);
	}
	.deposit-head {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 var(--space-4);
		padding-bottom: var(--space-2);
		border-bottom: 1px solid var(--color-divider);
	}
	.deposit-line {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		margin: 0 0 var(--space-3);
		font-size: 14px;
	}
	.deposit-line span:last-child {
		font-family: var(--font-heading);
		font-size: 17px;
	}
	.deposit-note {
		margin: var(--space-4) 0 0;
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-divider);
		font-size: 12px;
		line-height: 1.6;
		color: color-mix(in srgb, var(--color-text) 62%, transparent);
	}

	/* — speed table — */
	.speed-wrap {
		max-width: 780px;
	}
	.speed td {
		font-family: var(--font-heading);
		font-size: 16px;
	}
	.speed .is-example {
		box-shadow: inset 2px 0 0 var(--color-accent);
	}
	.speed .is-example td {
		color: var(--color-accent-700);
	}
	.speed-note {
		margin: clamp(22px, 3vw, 32px) 0 0;
		max-width: 66ch;
		font-size: 14.5px;
		line-height: 1.7;
	}

	/* — payment — */
	.methods {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		margin: var(--space-4) 0 var(--space-4);
		padding: 0;
	}
	.methods-note {
		margin: 0;
		font-size: 13.5px;
		line-height: 1.65;
		max-width: 52ch;
		color: color-mix(in srgb, var(--color-text) 74%, transparent);
	}
	.term {
		padding-block: var(--space-4);
		border-top: 1px solid var(--color-divider);
	}
	.term:first-child {
		padding-top: 0;
		border-top: 0;
	}
	.term-title {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: clamp(17px, 1.6vw, 20px);
		margin: 0 0 var(--space-2);
	}
	.term-body {
		margin: 0;
		font-size: 13.5px;
		line-height: 1.68;
		color: color-mix(in srgb, var(--color-text) 78%, transparent);
	}
</style>
