---
/**
 * FAQ accordion on native <details>/<summary> — no JavaScript, keyboard
 * accessible for free, and the answers stay in the DOM so they are indexable
 * whether or not a panel happens to be open.
 */
import type { Faq } from '../data/faqs';

interface Props {
	items: Faq[];
}
const { items } = Astro.props;
---

<div class="faq-list">
	{
		items.map((f) => (
			<details class="faq">
				<summary>
					<span class="faq-q">{f.q}</span>
					<span class="faq-mark" aria-hidden="true" />
				</summary>
				<p class="faq-a">{f.a}</p>
			</details>
		))
	}
</div>

<style>
	.faq-list {
		max-width: 80ch;
		border-top: 1px solid var(--color-divider);
	}
	.faq {
		border-bottom: 1px solid var(--color-divider);
	}
	.faq summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-4);
		cursor: pointer;
		list-style: none;
	}
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq summary:hover .faq-q {
		color: var(--color-accent-text);
	}
	.faq summary:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}
	.faq-q {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: clamp(16px, 1.5vw, 19px);
		line-height: 1.3;
	}

	/* A plus that becomes a minus — drawn from two rules, in keeping with a
	   system that draws with strokes rather than importing an icon set. */
	.faq-mark {
		position: relative;
		flex: none;
		width: 13px;
		height: 13px;
	}
	.faq-mark::before,
	.faq-mark::after {
		content: '';
		position: absolute;
		background: var(--color-accent);
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}
	.faq-mark::before {
		inset: 6px 0 6px 0;
		height: 1px;
	}
	.faq-mark::after {
		inset: 0 6px 0 6px;
		width: 1px;
	}
	.faq[open] .faq-mark::after {
		transform: scaleY(0);
		opacity: 0;
	}

	.faq-a {
		margin: 0;
		padding: 0 var(--space-8) var(--space-4) 0;
		font-size: 14.5px;
		line-height: 1.7;
		max-width: 68ch;
		color: color-mix(in srgb, var(--color-text) 80%, transparent);
	}
</style>
