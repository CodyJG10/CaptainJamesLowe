---
/**
 * The cinematic hero.
 *
 * This is the one place the site departs from the Classical system's "no large
 * fills" rule, and it departs deliberately. The departure is made to read as
 * intentional rather than accidental by keeping everything else: the video is
 * graded to match `.plate`'s warm archival treatment so it belongs to the same
 * photographic world, the frame is a gold hairline rather than a border, and
 * the type is Cormorant at the light display cut. Below the fold the page
 * resolves into the light editorial ground and stays there.
 *
 * PERFORMANCE — the part that matters more than the look:
 *
 *   · The POSTER is the LCP element. It is a real <Image>, eager, high
 *     priority, with a responsive srcset. It is what gets measured, and it
 *     paints without waiting on any video byte.
 *   · The <video> ships with NO src attribute. Nothing is fetched until the
 *     script decides it should be, which is after `load` — so the video can
 *     never compete with the poster, the fonts or the CSS.
 *   · Small screens, reduced-motion users and anyone on Save-Data or a 2g/3g
 *     connection never fetch the video at all. They keep the poster, which is
 *     a perfectly good hero.
 *
 * A hero video that costs three seconds of LCP is worse than no hero video.
 */
import { Image } from 'astro:assets';
import poster from '../assets/cjl/stock/hero-passage-poster.jpg';
import { site } from '../data/site';

interface Props {
	kicker: string;
	headingTop: string;
	headingBottom: string;
	lede: string;
	note?: string;
}
const { kicker, headingTop, headingBottom, lede, note } = Astro.props;
---

<section class="hero">
	<div class="hero-media">
		<Image
			class="hero-poster"
			src={poster}
			alt="A ketch under sail on open water, seen from above"
			widths={[640, 960, 1280, 1600, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			decoding="sync"
		/>
		<!-- No src: the script below decides whether this device gets video. -->
		<video
			class="hero-video"
			data-src="/video/hero-passage.mp4"
			muted
			loop
			playsinline
			preload="none"
			aria-hidden="true"
			tabindex="-1"></video>
		<div class="hero-scrim"></div>
		<div class="hero-frame" aria-hidden="true"></div>
	</div>

	<div class="container hero-inner">
		<p class="hero-kicker">{kicker}</p>
		<h1 class="hero-heading">
			<span>{headingTop}</span>
			<span>{headingBottom}</span>
		</h1>
		<p class="hero-lede">{lede}</p>
		<div class="hero-actions">
			<a class="btn btn-primary btn-lg" href="/quote">Start your estimate</a>
			<a class="btn btn-secondary btn-lg" href={site.phoneHref}>
				Call {site.phoneDisplay}
			</a>
		</div>
		{note && <p class="hero-note">{note}</p>}
	</div>

	<a class="hero-scroll" href="#what-we-do" aria-label="Scroll to services">
		<span class="hero-scroll-rule" aria-hidden="true"></span>
	</a>
</section>

<script is:inline>
	(() => {
		const video = document.querySelector('.hero-video');
		if (!video) return;

		const conn = navigator.connection || {};
		const slow = conn.saveData === true || /2g|3g/.test(conn.effectiveType || '');
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const small = window.matchMedia('(max-width: 860px)').matches;

		// Anyone in these buckets keeps the poster and never pays for the video.
		if (slow || reduced || small) return;

		const start = () => {
			video.src = video.dataset.src;
			video.load();
			// Only reveal once there are actual frames — otherwise the fade
			// exposes a black box while the first bytes are still arriving.
			video.addEventListener(
				'playing',
				() => video.classList.add('is-ready'),
				{ once: true },
			);
			// Autoplay can still be refused (low power mode, iOS settings).
			// The poster is already there, so a rejection needs no handling
			// beyond not throwing.
			const played = video.play();
			if (played && typeof played.catch === 'function') played.catch(() => {});
		};

		if (document.readyState === 'complete') start();
		else window.addEventListener('load', start, { once: true });
	})();
</script>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: min(100svh, 940px);
		padding-block: clamp(140px, 22vh, 220px) clamp(56px, 9vh, 104px);
		overflow: hidden;
		background: var(--ink-deep);
		color: #f3f2f2;
		isolation: isolate;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	.hero-poster,
	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/*
		 * The .plate grade, pushed a little further for legibility under type.
		 * This is what ties the hero to every other photograph on the site.
		 */
		filter: sepia(0.28) saturate(0.72) contrast(1.06) brightness(0.72);
	}

	.hero-video {
		opacity: 0;
		transition: opacity 1.1s ease;
	}
	.hero-video.is-ready {
		opacity: 1;
	}

	/*
	 * Two scrims, not one. A flat overlay dims the picture evenly and kills it;
	 * a bottom-weighted gradient plus a left-weighted one darkens exactly where
	 * the type sits and lets the water keep its light everywhere else.
	 */
	.hero-scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				to top,
				rgba(20, 19, 17, 0.92) 0%,
				rgba(20, 19, 17, 0.55) 38%,
				rgba(20, 19, 17, 0.12) 68%,
				rgba(20, 19, 17, 0.4) 100%
			),
			linear-gradient(to right, rgba(20, 19, 17, 0.6) 0%, rgba(20, 19, 17, 0) 62%);
	}

	/* The gold hairline — stroke, the way the system wants its color used. */
	.hero-frame {
		position: absolute;
		inset: clamp(12px, 1.6vw, 22px);
		border: 1px solid color-mix(in srgb, var(--color-accent-300) 42%, transparent);
		pointer-events: none;
	}

	.hero-inner {
		position: relative;
		width: 100%;
	}

	.hero-kicker {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: clamp(10px, 1.1vw, 12px);
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-accent-300);
		margin: 0 0 clamp(18px, 2.4vw, 28px);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid color-mix(in srgb, #f3f2f2 26%, transparent);
		/* The rule under the kicker should measure the kicker, not a column —
		   fit-content keeps it on one line wherever there is room and lets it
		   wrap only when there genuinely is not. */
		width: fit-content;
		max-width: 100%;
	}

	.hero-heading {
		font-family: var(--font-heading);
		/* Display sizes take the normal cut — the bigger it is, the lighter. */
		font-weight: 400;
		font-size: clamp(40px, 6.4vw, 88px);
		line-height: 1.03;
		letter-spacing: -0.018em;
		margin: 0 0 clamp(20px, 2.6vw, 30px);
		margin-left: -0.042em;
		max-width: 16ch;
		text-wrap: balance;
	}
	.hero-heading span {
		display: block;
	}

	.hero-lede {
		font-size: clamp(15px, 1.35vw, 18.5px);
		line-height: 1.62;
		max-width: 56ch;
		margin: 0 0 clamp(26px, 3vw, 38px);
		color: color-mix(in srgb, #f3f2f2 88%, transparent);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
	/* Rescope the outlined buttons for the dark ground. */
	.hero-actions .btn-primary {
		color: var(--color-accent-300);
		border-color: var(--color-accent-300);
	}
	.hero-actions .btn-primary:hover {
		background: color-mix(in srgb, var(--color-accent-300) 16%, transparent);
	}
	.hero-actions .btn-secondary {
		color: #f3f2f2;
		border-color: color-mix(in srgb, #f3f2f2 40%, transparent);
	}
	.hero-actions .btn-secondary:hover {
		background: color-mix(in srgb, #f3f2f2 12%, transparent);
	}

	.hero-note {
		margin: var(--space-4) 0 0;
		font-size: 12.5px;
		letter-spacing: 0.02em;
		color: color-mix(in srgb, #f3f2f2 62%, transparent);
	}

	/* A hairline that draws itself downward — the only motion outside the video. */
	.hero-scroll {
		position: absolute;
		left: 50%;
		bottom: clamp(16px, 2.4vw, 30px);
		width: 40px;
		height: 46px;
		transform: translateX(-50%);
		display: grid;
		place-items: start center;
	}
	.hero-scroll-rule {
		width: 1px;
		height: 40px;
		background: linear-gradient(
			to bottom,
			transparent,
			color-mix(in srgb, var(--color-accent-300) 80%, transparent)
		);
		transform-origin: top;
		animation: rule-drop 2.6s ease-in-out infinite;
	}
	@keyframes rule-drop {
		0%,
		100% {
			transform: scaleY(0.35);
			opacity: 0.35;
		}
		50% {
			transform: scaleY(1);
			opacity: 1;
		}
	}

	@media (max-width: 860px) {
		.hero {
			min-height: min(88svh, 720px);
			align-items: flex-end;
		}
		.hero-heading {
			max-width: 14ch;
		}
		.hero-scroll {
			display: none;
		}
		/* Less horizontal darkening on narrow screens — the type spans the
		   full width there, so the left-weighted gradient does nothing but
		   flatten the picture. */
		.hero-scrim {
			background: linear-gradient(
				to top,
				rgba(20, 19, 17, 0.94) 0%,
				rgba(20, 19, 17, 0.6) 46%,
				rgba(20, 19, 17, 0.2) 78%,
				rgba(20, 19, 17, 0.42) 100%
			);
		}
	}
</style>
