---
/**
 * Shared shell for the three legal pages. Narrow measure, plain hierarchy,
 * nothing decorative — these want to be read and quoted, not admired.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';

export interface LegalSection {
	heading: string;
	body: string[];
	list?: string[];
}

interface Props {
	kicker: string;
	heading: string;
	lede: string;
	title: string;
	description: string;
	sections: LegalSection[];
	updated?: string;
}

const { kicker, heading, lede, title, description, sections, updated } = Astro.props;
---

<Layout {title} {description}>
	<PageHero {kicker} {heading} {lede} />

	<section class="section">
		<div class="container">
			<article class="legal prose">
				{
					sections.map((s) => (
						<section class="legal-section">
							<h2>{s.heading}</h2>
							{s.body.map((p) => (
								<p>{p}</p>
							))}
							{s.list && (
								<ul>
									{s.list.map((li) => (
										<li>{li}</li>
									))}
								</ul>
							)}
						</section>
					))
				}
				{updated && <p class="updated">Last updated {updated}.</p>}
			</article>
		</div>
	</section>
</Layout>

<style>
	.legal {
		max-width: 72ch;
	}
	.legal-section + .legal-section {
		margin-top: clamp(30px, 4vw, 48px);
		padding-top: clamp(26px, 3.4vw, 40px);
		border-top: 1px solid var(--color-divider);
	}
	.legal h2 {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: clamp(21px, 2.2vw, 27px);
		line-height: 1.2;
		margin: 0 0 var(--space-4);
	}
	.legal p {
		font-size: 14.5px;
		line-height: 1.75;
	}
	.legal li {
		font-size: 14.5px;
		line-height: 1.7;
	}
	.updated {
		margin-top: clamp(30px, 4vw, 48px);
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-divider);
		font-size: 12px;
		text-align: left;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
	}
</style>
