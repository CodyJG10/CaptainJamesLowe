---
/**
 * Site header.
 *
 * Two states. Normally it sits on the page ground with a hairline beneath it.
 * With `transparent` (the homepage, over the video hero) it becomes an overlay
 * in paper-on-ink: same layout, inverted palette, no bottom rule — the hero's
 * own edge does that job.
 *
 * Below 1080px the nav becomes a full-screen panel sliding in from the right.
 * It is driven by a hidden checkbox and a sibling selector, so it opens and
 * closes with zero JavaScript; one small inline script adds Escape-to-close and
 * closes it on navigation, which CSS alone cannot do.
 */
import { Image } from 'astro:assets';
import { site, nav } from '../data/site';
import logo from '../assets/cjl/site/logo-transparent.png';

interface Props {
	transparent?: boolean;
}
const { transparent = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class:list={['site-header', { transparent }]}>
	<div class="utility">
		<div class="container utility-inner">
			<span class="utility-license">{site.license}</span>
			<a class="utility-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
		</div>
	</div>

	<div class="container bar">
		<a class="brand" href="/">
			<Image class="brand-mark" src={logo} alt="" width={48} height={42} loading="eager" />
			<span class="brand-text">
				<span class="brand-name">Captain James Lowe</span>
				<span class="brand-sub">Yacht Delivery</span>
			</span>
		</a>

		<input type="checkbox" id="nav-toggle" class="nav-toggle sr-only" />
		<label class="nav-burger" for="nav-toggle" aria-label="Menu">
			<span></span><span></span><span></span>
		</label>

		<nav class="nav-panel" aria-label="Primary">
			{/* Panel-only header. On desktop the panel is just a row of links and
			    this is hidden; on mobile it covers the page, so it needs its own
			    identity and a way out. */}
			<div class="panel-top">
				<span class="panel-brand">Captain James Lowe</span>
				<label class="nav-close" for="nav-toggle" aria-label="Close menu">
					<span></span><span></span>
				</label>
			</div>

			<ul class="nav-list">
				{
					nav.map((item) => (
						<li>
							<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<div class="nav-actions">
				<a class="btn btn-primary" href="/quote">Get a quote</a>
				<a class="nav-phone" href={site.phoneHref}>{site.phoneDisplay}</a>
			</div>
		</nav>
	</div>
</header>

<script is:inline>
	(() => {
		const toggle = document.getElementById('nav-toggle');
		if (!toggle) return;
		const close = () => (toggle.checked = false);
		document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
		document.querySelectorAll('.nav-panel a').forEach((a) => a.addEventListener('click', close));
	})();
</script>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-divider);
	}

	/* Overlay state — the hero scrolls beneath it. */
	.site-header.transparent {
		position: absolute;
		inset: 0 0 auto;
		background: transparent;
		border-bottom-color: transparent;
		--color-text: #f3f2f2;
		--color-divider: color-mix(in srgb, #f3f2f2 22%, transparent);
		--color-accent: var(--color-accent-300);
		/* Over the video the ground is dark, so the text accents have to invert
		   up the ramp exactly as they do in .band-ink. Without these they stay
		   at accent-700 — a dark brown on dark footage. */
		--color-accent-text: var(--color-accent-300);
		--color-accent-display: var(--color-accent-300);
		color: #f3f2f2;
	}

	/* — utility strip — */
	.utility {
		border-bottom: 1px solid var(--color-divider);
		font-size: 11px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.utility-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: 7px;
	}
	.utility-license {
		font-family: var(--font-heading);
		color: color-mix(in srgb, var(--color-text) 62%, transparent);
	}
	.utility-phone {
		font-family: var(--font-heading);
		color: var(--color-accent-text);
		text-decoration: none;
		font-variant-numeric: tabular-nums;
	}
	.utility-phone:hover {
		text-decoration: underline;
	}

	/* — main bar — */
	.bar {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		padding-block: var(--space-3);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		text-decoration: none;
		color: inherit;
		margin-right: auto;
	}
	.brand-mark {
		width: 48px;
		height: auto;
		flex: none;
	}
	/* The mark is black line art, so it inverts cleanly for the overlay state. */
	.transparent .brand-mark {
		filter: invert(1);
	}
	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}
	.brand-name {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: clamp(17px, 1.8vw, 21px);
		letter-spacing: -0.01em;
	}
	.brand-sub {
		font-family: var(--font-heading);
		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-accent-text);
		margin-top: 3px;
	}

	.nav-panel {
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}
	.nav-list {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.nav-list a {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 14px;
		color: inherit;
		text-decoration: none;
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
		white-space: nowrap;
	}
	.nav-list a:hover {
		color: var(--color-accent-text);
	}
	.nav-list a[aria-current='page'] {
		color: var(--color-accent-text);
		border-bottom-color: var(--color-accent);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}
	.nav-phone {
		display: none;
	}

	/* — burger, hidden until the nav no longer fits — */
	.nav-burger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		padding: 9px 7px;
		cursor: pointer;
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
	}
	.nav-burger span {
		display: block;
		height: 1px;
		background: var(--color-text);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.nav-toggle:focus-visible + .nav-burger {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	/* The panel-only header is desktop-hidden; it exists for the mobile overlay. */
	.panel-top {
		display: none;
	}

	@media (max-width: 1080px) {
		.nav-burger {
			display: flex;
		}

		/*
		 * Full-screen panel, sliding in from the right.
		 *
		 * visibility (not display) so the slide can animate and so the links
		 * stay out of the accessibility tree and out of tab order while closed.
		 * The visibility transition is delayed on the way out only, so the panel
		 * remains rendered for the length of the slide and then disappears.
		 */
		.nav-panel {
			position: fixed;
			inset: 0;
			z-index: 90;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0 var(--gutter) calc(var(--space-8) + env(safe-area-inset-bottom));
			overflow-y: auto;
			overscroll-behavior: contain;
			background: var(--color-bg);
			transform: translateX(100%);
			visibility: hidden;
			transition:
				transform 0.34s var(--ease-out),
				visibility 0s 0.34s;
		}

		/*
		 * The panel covers the page on its own paper ground, so it needs the
		 * LIGHT palette regardless of what the header is doing over the hero.
		 * All five tokens — missing --color-accent-text here is what left the
		 * quote button and phone number as pale gold on near-white.
		 */
		.site-header .nav-panel,
		.site-header.transparent .nav-panel {
			color: #201f1d;
			--color-text: #201f1d;
			--color-divider: color-mix(in srgb, #201f1d 16%, transparent);
			--color-accent: #b68235;
			--color-accent-text: var(--color-accent-700);
			--color-accent-display: var(--color-accent-600);
		}

		.nav-toggle:checked ~ .nav-panel {
			transform: none;
			visibility: visible;
			transition:
				transform 0.34s var(--ease-out),
				visibility 0s 0s;
		}

		/* Hold the page still behind the overlay. */
		:global(html:has(.nav-toggle:checked)) {
			overflow: hidden;
		}

		.panel-top {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-4);
			padding-block: var(--space-4);
			margin-bottom: var(--space-4);
			border-bottom: 1px solid var(--color-divider);
		}
		.panel-brand {
			font-family: var(--font-heading);
			font-weight: var(--font-heading-weight);
			font-size: 17px;
		}
		.nav-close {
			position: relative;
			width: 44px;
			height: 44px;
			flex: none;
			cursor: pointer;
			border: 1px solid var(--color-divider);
			border-radius: var(--radius-md);
		}
		.nav-close span {
			position: absolute;
			left: 12px;
			right: 12px;
			top: 50%;
			height: 1px;
			background: var(--color-text);
		}
		.nav-close span:first-child {
			transform: rotate(45deg);
		}
		.nav-close span:last-child {
			transform: rotate(-45deg);
		}

		.nav-list {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}
		.nav-list li + li {
			border-top: 1px solid var(--color-divider);
		}
		.nav-list a {
			display: block;
			padding: var(--space-4) 0;
			font-size: 21px;
			border-bottom: 0;
		}
		.nav-actions {
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-3);
			margin-top: var(--space-6);
		}
		.nav-actions .btn {
			font-size: 16px;
			padding-block: var(--space-3);
		}
		.nav-phone {
			display: block;
			text-align: center;
			font-family: var(--font-heading);
			font-size: 19px;
			color: var(--color-accent-text);
			text-decoration: none;
			font-variant-numeric: tabular-nums;
		}
	}

	@media (max-width: 560px) {
		.utility-license {
			font-size: 10px;
		}
		.brand-mark {
			width: 40px;
		}
	}
</style>
